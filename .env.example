# ── Required ──────────────────────────────────────────────────────────────────

# Postgres with the pgvector and pg_trgm extensions. Local Docker, Supabase,
# Neon, Fly Postgres — anything works. The schema is created on first run.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognita
DATABASE_SSL=false

# Embeddings. This is the one paid dependency the server cannot run without.
OPENAI_API_KEY=sk-...


# ── Optional: better search ───────────────────────────────────────────────────
# Without this key the server still works — it just falls back to plain hybrid
# search. With it, two things improve:
#   contextual indexing — each passage is indexed alongside a sentence saying
#                         where it sits in the book, so a passage full of "he"
#                         and "this" is still findable
#   reranking           — a model reorders results by how well they answer the
#                         query, which fixes hybrid search's weakest point
ANTHROPIC_API_KEY=sk-ant-...

CONTEXT_ENABLED=true
CONTEXT_MODEL=claude-haiku-4-5-20251001
CONTEXT_MAX_CHARS=8000
CONTEXT_CONCURRENCY=4

RERANK_ENABLED=true
RERANK_MODEL=claude-haiku-4-5-20251001
RERANK_CANDIDATES=40
RERANK_BATCH_SIZE=20


# ── Optional: scanned PDFs ────────────────────────────────────────────────────
# Only used when a PDF has no text layer. Without it such a book fails to
# ingest and says so.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest


# ── Optional: hosting ─────────────────────────────────────────────────────────
# Required only when running with --http. Callers send it as a bearer token.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNITA_AUTH_TOKEN=
# Whether the add_book_from_path / add_books_from_folder tools work over HTTP.
# Leave false on a hosted server: its disk is not the caller's disk.
COGNITA_ALLOW_LOCAL_FILES=false
# Hostnames the server answers to, comma-separated. MCP rejects unrecognised
# Host headers, so a deployment must list its public name or every request 421s.
COGNITA_ALLOWED_HOSTS=

MCP_HOST=127.0.0.1
MCP_PORT=8001
LOG_LEVEL=INFO


# ── Tuning ────────────────────────────────────────────────────────────────────

# Embedding model. EMBED_DIM is sent to the API, so lowering it really does
# produce shorter vectors — 1536 halves storage for a small quality cost.
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# Chunking. Larger chunks give more context per hit, smaller ones sharper
# matches. Overlap keeps an idea findable when it straddles a boundary.
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Rank fusion. Raise RRF_SEMANTIC_WEIGHT to favour meaning over exact wording,
# RRF_KEYWORD_WEIGHT for the reverse. RRF_K flattens the difference between
# adjacent ranks.
RRF_K=60
RRF_SEMANTIC_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.0

# Vector index breadth. Higher = better recall, slower search.
HNSW_EF_SEARCH=100

# Fold results that sit next to each other in a book into one passage.
MERGE_ADJACENT=true
# Cap results from any single book so one cannot crowd out the library. 0 = off.
MAX_PER_BOOK=0

# Books ingested at once, and the size ceiling for a single file.
INGEST_CONCURRENCY=2
MAX_FILE_MB=100
