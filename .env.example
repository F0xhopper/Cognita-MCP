# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (Supabase connection pooler recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Auth
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OpenAI (embeddings)
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# Mistral AI (document parsing / OCR + deep research chat)
MISTRAL_API_KEY=...
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-large-latest

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# Chunking tuning
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Deep research tuning
RESEARCH_TOP_K_PER_QUERY=6
RESEARCH_MAX_PASSAGES=24

# MCP server port (runs alongside FastAPI)
MCP_PORT=8001
